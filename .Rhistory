generate_signal <- function(n,
pattern = c("none", "up", "updown", "rand1"),
nbSeg = 8,
jumpSize = 1)
{
type <- match.arg(pattern)
if (type == "rand1") {
set.seed(42)
rand1CP <- rpois(nbSeg, lambda = 10)
# Scale counts to total n
r1 <- pmax(round(rand1CP * n / sum(rand1CP)), 1)
# Adjust to sum exactly n
diff <- n - sum(r1)
r1[nbSeg] <- r1[nbSeg] + diff
stopifnot(sum(r1) == n)
set.seed(43)
rand1Jump <- runif(nbSeg, min = 0.5, max = 1) * sample(c(-1, 1), nbSeg, replace = TRUE)
set.seed(NULL)
}
switch(
type,
none = rep(0, n),
up = rep(seq(0, nbSeg - 1) * jumpSize, each = n / nbSeg),
updown = rep((seq(0, nbSeg - 1) %% 2) * jumpSize, each = n / nbSeg),
rand1 = map2(rand1Jump, r1, ~rep(.x * jumpSize, .y)) %>% unlist()
)
}
### choice of parameter
test <- c("WilcoxonCost", "MedianMoodCost")
myValidity <- test[1]
gamma <- 400
# data genration and true changepoints
n <- 1000
signal <- generate_signal(n, "up", 8, 0.5)
chpt <- which(diff(signal) != 0)
chpt <- c(chpt, n)
y <- signal + rt(n, df = 2)
plot(y)
# SVP one RUN
out <- SVP_costTests(y, test = "WilcoxonCost", gamma = gamma)
out$changepoints
chpt
# true changepoints (red dashed)
abline(v = chpt, col = "blue", lty = 2, lwd = 2)
# estimated changepoints (blue solid)
abline(v = out$changepoints, col = "red", lty = 1, lwd = 2)
