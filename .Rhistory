resPELT <- cpt.mean(y, method = "PELT", penalty = "Manual", pen.value = 2 * log(n/nbSeg))
abline(v = resPELT@cpts, col = 4, lwd = 3, lty = 5)
#abline(v = which(diff(mu) != 0), col = 1, lwd = 1, lty = 1)
legend("topleft",
legend = c("SVP Wilcoxon", "SVP Gaussian (FOCUS)", "PELT", "True change-points", "median"),
col    = c(2, 3, 4, 1,6),
lwd    = c(5, 3, 3, 1,3),
lty    = c(1, 2, 5, 1,1),
bty    = "n")
c(nbSeg, length(resW$changepoints),
length(resFOCUS$changepoints),
length(resPELT@cpts),
length(resM$changepoints))
