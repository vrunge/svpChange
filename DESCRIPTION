Package: svpChange
Type: Package
Title: Smallest Valid Partitioning Algorithm (SVP)
Version: 0.1.0
Authors@R: c(
    person("Vincent", "Runge", email = "vincent.runge@univ-evry.fr", role = c("aut", "cre", "cph")),
    person("Alexandre", "Combeau", email = "alexandre.combeau.77@gmail.com", role = c("aut")),
